{
  "name": "@splunk/log-serv-app",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node bin/build.js build && yarn types:build && node bin/generate-sbom.js && node bin/generate-third-party-notices.js",
    "build:ci": "yarn audit:ci && yarn build",
    "build:templates-only": "node bin/build.js build --templates-only && yarn types:build && node bin/generate-sbom.js && node bin/generate-third-party-notices.js",
    "build:ci:templates-only": "yarn audit:ci && yarn build:templates-only",
    "audit:ci": "yarn audit --groups dependencies --level high",
    "sbom": "node bin/generate-sbom.js",
    "third-party-notices": "node bin/generate-third-party-notices.js",
    "eslint": "eslint src --ext \".ts,.tsx,.js,.jsx\"",
    "eslint:ci": "yarn run eslint -f junit -o test-reports/lint-results.xml",
    "eslint:fix": "eslint src --ext \".ts,.tsx,.js,.jsx\" --fix",
    "link:app": "node bin/build.js link",
    "lint": "yarn run eslint && yarn run stylelint",
    "lint:ci": "yarn run eslint:ci && yarn run stylelint",
    "start": "webpack --watch",
    "stylelint": "stylelint \"src/**/*.{ts,tsx,js,jsx}\" --config stylelint.config.js",
    "types:build": "tsc",
    "types:start": "yarn types:build --watch"
  },
  "dependencies": {
    "@splunk/dashboards": "^0.0.1",
    "@splunk/react-page": "^8.3.1",
    "@splunk/react-time-range": "^12.0.0",
    "@splunk/react-ui": "^5.9.1",
    "@splunk/search-job": "^3.1.0",
    "@splunk/splunk-utils": "^3.4.0",
    "@splunk/themes": "^1.7.0",
    "@splunk/visualization-context": "^28.5.3",
    "@splunk/visualizations": "^28.5.3",
    "@xyflow/react": "^12.10.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^18.2.0",
    "react-router-dom": "^7.14.2",
    "styled-components": "^5.3.10"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "^7.28.0",
    "@splunk/babel-preset": "^4.0.0",
    "@splunk/eslint-config": "^5.1.0",
    "@splunk/stylelint-config": "^5.0.0",
    "@splunk/webpack-configs": "^7.0.3",
    "@types/d3-force": "^3.0.10",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "babel-loader": "^8.3.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-webpack": "^0.13.4",
    "eslint-plugin-import": "^2.30.1",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "html-webpack-plugin": "^5.5.3",
    "react-dom": "^18.2.0",
    "shelljs": "^0.8.5",
    "style-loader": "^4.0.0",
    "stylelint": "^15.11.0",
    "typescript": "^5.8.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
