# LogServ Data Doctor reports (build 311 / session 096). Same deliberately
# permissive ACL as every other logserv_* collection: any authenticated user
# must be able to persist + list diagnostic reports (the #/diagnostics page is
# NOT admin-gated). Consequence: rows are untrusted — the app validates on
# read (diagPersistence) and the page carries NO destructive controls. Stored
# reports are shared, unauthenticated-integrity artifacts; the authoritative
# copy is the one downloaded at generation time.
[collections/logserv_diag_reports]
access = read : [ * ], write : [ * ]
export = system

# Operator-supplied ingest evidence (build 314 / session 099, design SS15).
# World read/write like every other logserv_* collection: the design requires
# a NON-admin to be able to paste the filter configuration an administrator
# ran for them (decision 8). Consequence: the row is untrusted — the app
# validates every field on read (diagIngestFacts.looksLikeIngestFacts), only
# ever reads the fixed key "latest", and every verdict built on it carries a
# "Supplied by operator — <user>, <when>" provenance line so a wrong or stale
# paste is traceable and re-suppliable.
[collections/logserv_diag_ingest_facts]
access = read : [ * ], write : [ * ]
export = system

# Data Doctor platform snapshot (build 315, design SS16). World-READABLE is
# the point of Tier B (one nobody-owned scheduled search makes _internal
# evidence readable by every role); world-writable is the standing logserv_*
# hazard, so the app sanitizes every row on read AND snapshot rows can never
# raise a verdict's confidence grade (SS16.8a-1).
[collections/logserv_diag_platform_snapshot]
access = read : [ * ], write : [ * ]
export = system
