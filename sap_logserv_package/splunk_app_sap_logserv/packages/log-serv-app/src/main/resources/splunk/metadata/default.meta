[]
owner = nobody
access = read : [ * ], write : [ admin, sc_admin, sc_subadmin ]
export = system

# Build 384: every KV collection below is written by the admin tier only (admin,
# sc_admin, sc_subadmin), except six that ordinary users write by design: the four
# per-user preference collections (topology layouts, layout defaults, active mode,
# dashboard refresh) and two Data Doctor collections (reports, ingest facts). Read
# stays open everywhere. utils/kvAcl.consistency-test.ts holds this list equal to the
# code's writers.

# Per-user named topology layouts (build 120 / A.4). All authenticated users
# need write access so they can save their own layouts. Records are keyed
# by `<username>::<slug>` as a convention — server-side ACL does NOT enforce
# per-user isolation at the record level. Acceptable for our dev/admin use
# cases; a server-side REST handler would be needed for strict multi-tenant
# isolation.
[collections/logserv_topology_layouts]
access = read : [ * ], write : [ * ]
export = system

# Per-user per-mode default-layout pointer (build 226 / session 037 / Path F).
# Same ACL convention as logserv_topology_layouts; per-user isolation via
# the `<username>::<layout_mode>` key.
[collections/logserv_topology_layout_defaults]
access = read : [ * ], write : [ * ]
export = system

# Per-user active layout mode preference (build 229 / session 037 / Option C).
# Stores which layout mode (force/layered/tree) the user prefers on first nav.
# One row per user keyed by <username>.
[collections/logserv_topology_active_mode]
access = read : [ * ], write : [ * ]
export = system

# Per-user per-dashboard refresh interval (build 155 / session 027). Same
# ACL convention as logserv_topology_layouts: all authenticated users need
# write access for their own preference rows; per-user isolation is a
# convention enforced via the `<username>::<dashboard_id>` key, not the
# server-side ACL.
[collections/logserv_dashboard_refresh]
access = read : [ * ], write : [ * ]
export = system

# Time-bucketed topology nodes + edges (session 035 / build 188). Read by
# the React app's authenticated session at view-render time; written by the
# scheduled saved searches running as nobody/admin. All authenticated users
# need read access. Since build 384 only the admin tier writes them: the scheduled
# searches run as splunk-system-user and the Settings > Dashboard Data backfill as
# the signed-in admin (every role could write them before).
[collections/logserv_topology_nodes]
access = read : [ * ], write : [ admin, sc_admin, sc_subadmin ]
export = system

[collections/logserv_topology_edges]
access = read : [ * ], write : [ admin, sc_admin, sc_subadmin ]
export = system

# IP/host -> SID inventory (session 035 / build 188). Read by the React
# app's authenticated session at view-render time to retarget raw-IP edge
# endpoints to their owning SID node; written by the
# logserv_topology_aggregate_inventory saved search.
[collections/logserv_topology_inventory]
access = read : [ * ], write : [ admin, sc_admin, sc_subadmin ]
export = system

# IP-node enrichment (session 112 / build 329). Read by the topology view's
# authenticated session at render time (hostname/user lines on IP partner
# squares + Overview facts rows); written by the
# logserv_topology_enrichment_aggregate / _backfill / _retention saved
# searches. Same collection-level ACL convention as the other topology
# collections.
[collections/logserv_topology_ip_enrichment]
access = read : [ * ], write : [ admin, sc_admin, sc_subadmin ]
export = system

# Environment Topology detail-tab rollup (session 060 / build 240). Read by the
# topology view's right-pane detail tabs (via | inputlookup) on node/edge
# selection; written by the logserv_topology_detail_aggregate / _backfill saved
# searches. Read by every role; since build 384 written by the admin tier only, like
# the other topology + rollup collections — KV-Store endpoints check only this
# collection-level ACL.
[collections/logserv_topology_detail_rollup]
access = read : [ * ], write : [ admin, sc_admin, sc_subadmin ]
export = system

# AI Assistant admin-managed settings (session 042 / Option D). Read by all
# authenticated users (the React app needs this on every page load to know
# whether the AI Assistant button should render); admin-tier users write
# from the Settings page. Server-side single-row convention: _key = "defaults".
# Build 380: written by admin-tier roles only. The row decides where an
# admin's browser sends secrets and data - the audit forwarder URL (with the
# HEC token), the MCP server URL (with its bearer token), the privacy tier -
# so a write open to every role let any user redirect them. A non-admin's
# conf-to-KV migration write at page load now fails quietly (best-effort).
[collections/logserv_ai_assistant_settings]
access = read : [ * ], write : [ admin, sc_admin, sc_subadmin ]
export = system

# AI Assistant per-stanza T&C acknowledgements (session 042 / Option D).
# Each row is keyed by the stanza name (e.g. "logserv-ai-assistant-enable-tc");
# the Settings page writes it on every T&C modal Submit / Cancel. Build 380:
# written by admin-tier roles only, like the settings (a user could otherwise
# record an acceptance an admin never gave); read stays open.
[collections/logserv_ai_assistant_acks]
access = read : [ * ], write : [ admin, sc_admin, sc_subadmin ]
export = system

# AI Assistant discovered-model cache (session 079 / build 275). Read by
# every user on chat-panel mount (merged into the model picker); written by
# the model-discovery refresh triggers (Settings refresh button, provider
# credential save, 24h lazy TTL). One row per provider, ids/labels
# allowlist-sanitized on write AND read; the static baseline always
# survives the merge so a poisoned row can't break chat. Build 380: written by
# admin-tier roles only - discovery needs the provider key, which only admins
# can read, and a non-admin's failed refresh no longer overwrites the row.
[collections/logserv_ai_models]
access = read : [ * ], write : [ admin, sc_admin, sc_subadmin ]
export = system

# Work Process Performance dashboard rollup (session 050 / build 206). Read by
# the dashboard's panels (via | inputlookup) at render time; written by the
# logserv_wp_perf_aggregate / _backfill saved searches. Read by every role;
# since build 384 written by the admin tier only, like every rollup and topology
# collection — KV-Store endpoints check only this collection-level ACL, no
# admin_all_objects capability gate.
[collections/logserv_wp_perf_rollup]
access = read : [ * ], write : [ admin, sc_admin, sc_subadmin ]
export = system

