# Settings > Dashboard Data backfill stage (build 378): written only by the
# admin-gated panel. Explicit since build 384 (it inherited [] before), so a change
# to [] can neither open nor close it.
[collections/logserv_backfill_stage]
access = read : [ * ], write : [ admin, sc_admin, sc_subadmin ]
export = system

# LogServ Data Doctor reports (build 311 / session 096). Deliberately permissive
# ACL (it stays writable by every role - since build 384 one of only six such
# collections): any authenticated user must be able to persist + list diagnostic
# reports (the #/diagnostics page is NOT admin-gated). Consequence: rows are
# untrusted — the app validates on read (diagPersistence) and the page carries
# NO destructive controls. Stored reports are shared, unauthenticated-integrity
# artifacts; the authoritative copy is the one downloaded at generation time.
[collections/logserv_diag_reports]
access = read : [ * ], write : [ * ]
export = system

# Operator-supplied ingest evidence (build 314 / session 099, design SS15).
# World read/write (it stays so - since build 384 one of only six such collections): the design requires
# a NON-admin to be able to paste the filter configuration an administrator
# ran for them (decision 8). Consequence: the row is untrusted — the app
# validates every field on read (diagIngestFacts.looksLikeIngestFacts), only
# ever reads the fixed key "latest", and every verdict built on it carries a
# "Recorded as supplied by <user> (name not verified), <when>" provenance line so a wrong or stale
# paste is traceable and re-suppliable.
[collections/logserv_diag_ingest_facts]
access = read : [ * ], write : [ * ]
export = system

# Data Doctor platform snapshot (build 315, design SS16). World-READABLE is
# the point of Tier B (one nobody-owned scheduled search makes _internal
# evidence readable by every role). Since build 384 only the admin tier (and the
# nobody-owned scheduled search) writes it; the app still sanitizes every row on
# read AND snapshot rows can never raise a verdict's confidence grade (SS16.8a-1),
# because rows from before build 384 or under a local.meta override may be forged.
[collections/logserv_diag_platform_snapshot]
access = read : [ * ], write : [ admin, sc_admin, sc_subadmin ]
export = system
