                "company": null
            }
        ],
        "releaseDate": null,
        "description": "Dashboards, analytics, AI Assistant, Environment Topology, and Splunk Enterprise Security integration for SAP LogServ data ingested by the companion Splunk TA for SAP LogServ. Provides CIM-aligned tagging across the Authentication, Change, Network_Sessions, and Web data models for SAP-specific sourcetypes (sap:hana:audit, sap:webdispatcher:access, sap:abap:icm, sap:scc:audit, sap:scc:http_access, sap:abap:gateway, sap:saprouter, sap:sapstartsrv, linux:sudolog). Also absorbs the parsing from the (archived) Splunk Add-on for ISC BIND v2.0.0 and Splunk Add-on for Squid Proxy v2.1.0 so customers no longer need those add-ons installed separately.",
        "classification": {
            "intendedAudience": "IT Professionals",
            "categories": [
                "Security, Fraud & Compliance"
            ],
            "developmentStatus": "Production/Stable"
        },
        "commonInformationModels": {
            "Authentication": "5.0.0",
            "Change": "5.0.0",
            "Network_Sessions": "5.0.0",
            "Web": "5.0.0"
        },
