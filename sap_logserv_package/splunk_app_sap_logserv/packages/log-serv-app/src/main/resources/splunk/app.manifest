{
    "schemaVersion": "2.0.0",
    "info": {
        "title": "Splunk App for SAP LogServ",
        "id": {
            "group": null,
            "name": "splunk_app_sap_logserv",
            "version": "0.1.1"
        },
        "author": [
            {
                "name": "Splunk",
