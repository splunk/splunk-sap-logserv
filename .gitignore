# mkdocs build output — regenerable from docs/ + mkdocs.yml
/site/

# One-off backup taken before the session-033 help-icon refresh —
# preserved on disk under testing/ but not for GitHub.
/docs_images_backup_pre_help_icon_refresh_2026-05-08/

# Local-only working dir for build artifacts the user keeps off-repo
# (iteration tarballs, mkdocs build output, old AppInspect reports,
# old release_binaries, etc.). Never commit this whole tree.
/testing/

# Editor + OS noise
.vscode/
*.swp
Thumbs.db

# Tarballs — broad ignore so iteration / dev tarballs never accidentally
# commit. Only the release artifacts below are allowed through, each named
# in full: a wildcard negation would let a build-suffixed tarball slip in
# if one ever landed in release_binaries/ by accident (mandate 7).
#
# v0.1.2 is the current canonical set. The v0.1.1 set is retained alongside
# it by product decision (2026-09-20), so it needs negations of its own --
# without them the broad ignore above would swallow the very files we kept.
*.tar.gz
!release_binaries/splunk_app_sap_logserv-0.1.2.tar.gz
!release_binaries/splunk_ta_sap_logserv-0.1.2.tar.gz
!release_binaries/splunk_ta_sap_logserv_azure-0.1.2.tar.gz
!release_binaries/splunk_ta_sap_logserv_gcp-0.1.2.tar.gz
!release_binaries/splunk_app_sap_logserv-0.1.1.tar.gz
!release_binaries/splunk_ta_sap_logserv-0.1.1.tar.gz
!release_binaries/splunk_ta_sap_logserv_azure-0.1.1.tar.gz
!release_binaries/splunk_ta_sap_logserv_gcp-0.1.1.tar.gz
